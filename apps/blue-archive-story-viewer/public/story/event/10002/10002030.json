    {
      "GroupId": 10002030,
      "SelectionGroup": 0,
      "BGMId": 0,
      "Sound": "",
      "Transition": 0,
      "BGName": 0,
      "BGEffect": 0,
      "PopupFileName": "",
      "ScriptKr": "3;히후미 수영복ND;09;후에에에에에에~~!?!?!?\n#3;closeup\n#3;em;[?!]\n#3;shake\n#fontsize;80",
      "TextJp": "ふええぇぇぇぇぇ！？！？",
      "TextCn": "咦咦咦────！？！？",
      "TextTh": "เอ๋~~!!?!?!?",
      "TextTw": "咦咦咦────！？！？",
      "TextEn": "What the...?!",
      "VoiceJp": "https://r2.rikaaa0928.moe/ba-story-viewer/tts/event/10002030/lines/0017.mp3",
      "VoiceId": 0,
      "TeenMode": false,
      "TextJpVoice": "[surprised]ふええぇぇぇぇぇ！？"
    },
    {
      "GroupId": 10002030,
      "SelectionGroup": 0,
      "BGMId": 0,
      "Sound": "",
