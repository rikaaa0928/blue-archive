      "BGMId": 0,
      "Sound": "",
      "Transition": 0,
      "BGName": 0,
      "BGEffect": 0,
      "PopupFileName": "",
      "ScriptKr": "[s] \"괜찮아. 즐거워하는 거 같으니.\"",
      "TextJp": "[s] \"大丈夫、ツルギも楽しそうだし。\"",
      "TextCn": "[s]「没事的，鹤城看起来很高兴。」",
      "TextTh": "[s] \"ไม่เป็นไรเลย ดูน่าสนุกดีออก\"",
      "TextTw": "[s]「沒事的，弦生看起來很高興。」",
      "TextEn": "[s] \"Nah. Looks like she's having fun.\"",
      "VoiceJp": "",
      "VoiceId": 0,
      "TeenMode": false,
      "TextJpVoice": ""
    },
