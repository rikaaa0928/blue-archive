      "BGName": 0,
      "BGEffect": 0,
      "PopupFileName": "",
      "ScriptKr": "3;히후미 수영복ND;00\n#3;a\n#wait;1300",
      "TextJp": "",
      "TextCn": "",
      "TextTh": "",
      "TextTw": "",
      "TextEn": "",
      "VoiceJp": "",
      "VoiceId": 0,
      "TeenMode": false,
