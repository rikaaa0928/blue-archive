    {
      "GroupId": 10002025,
      "SelectionGroup": 0,
      "BGMId": 0,
      "Sound": "SE_Cartoon_01",
      "Transition": 0,
      "BGName": 0,
      "BGEffect": 0,
      "PopupFileName": "",
      "ScriptKr": "1;수영복 불량배 MG;05;후, 후퇴다! 이 대가는 비쌀 거다, 이놈들!!\n#1;hophop",
      "TextJp": "くそっ、覚えてろよ！？",
      "TextCn": "可恶，给我记住！！",
      "TextTh": "ถะ...ถอยก่อนเร็ว! ฝะ...ฝากไว้ก่อนเถอะนะ ยัยงี่เง่า!!",
      "TextTw": "可惡，給我記住！！",
      "TextEn": "Retreat! You will pay for this!",
      "VoiceJp": "https://r2.rikaaa0928.moe/ba-story-viewer/tts/event/10002025/lines/0007.mp3",
      "VoiceId": 0,
      "TeenMode": false,
      "TextJpVoice": "[angry]くそっ、覚えてろよ！？"
    },
